<?xml version="1.0" encoding="UTF-8"?>
<!--
  Instagram Analytics sync — every day at 07:40.

  Reads each client account's public Instagram numbers (scripts/sync_ig_analytics.py)
  and writes hub/igAnalytics + hub/igPosts_YYYY-MM for the Studio Hub's Instagram
  Analytics page. Daily, because Instagram only lists an account's newest 6 posts:
  a missed week is missed posts. launchd runs a missed slot when the Mac next wakes.

  NOT installed automatically. Install only after a supervised run:

      cp scripts/com.anomaly.ig-analytics-daily.plist ~/Library/LaunchAgents/
      launchctl load ~/Library/LaunchAgents/com.anomaly.ig-analytics-daily.plist

  To check on it:
      launchctl list | grep anomaly
      tail -f ~/Library/Logs/anomaly-ig-analytics.log

  To stop it:
      launchctl unload ~/Library/LaunchAgents/com.anomaly.ig-analytics-daily.plist

  /usr/bin/python3 is invoked directly — no shell wrapper — because a
  launchd-spawned zsh has no Desktop access (that is why the ad-picks monthly
  job never runs). 07:40 sits clear of the other morning jobs: social stats
  Mon 06:40, financials Mon 07:15, Ares 08:47, the scheduled Claude tasks from 09:02.
  A run takes roughly 10 to 20 minutes: it reads slowly on purpose.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.anomaly.ig-analytics-daily</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Users/danielpan/Desktop/Claude/Anomaly-Studio-Hub/scripts/sync_ig_analytics.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/danielpan/Desktop/Claude/Anomaly-Studio-Hub</string>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key><integer>7</integer>
        <key>Minute</key><integer>40</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/danielpan/Library/Logs/anomaly-ig-analytics.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/danielpan/Library/Logs/anomaly-ig-analytics.log</string>
</dict>
</plist>
